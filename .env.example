# === App ===
APP_ENV=development
DEBUG=true
LOG_LEVEL=DEBUG

# === Database ===
# Docker compose ichida: postgres:5432, host'dan: localhost:55432
DATABASE_URL=postgresql+asyncpg://dasturchi_05:571632@localhost:55432/docchat
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# === Redis ===
REDIS_URL=redis://localhost:6379/0

# === JWT ===
JWT_SECRET=super_secret_change_me_in_production_min_32_chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# === LLM ===
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# Ollama uchun (alternativ, lokal):
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# EMBEDDING_DIMENSION=768

# === Limits ===
UPLOAD_MAX_SIZE_MB=50
RATE_LIMIT_PER_MINUTE=60

# === Frontend (Docker compose uchun) ===
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
